# Include development and release resources in the source distribution.
include README.md CHANGELOG.md .env.example .gitignore .dockerignore .python-version
include Dockerfile docker-compose.yml uv.lock
recursive-include config *.yaml
recursive-include docs *.md
recursive-include packaging *.md *.json *.html *.service
recursive-include scripts *.sh
recursive-include tools *.py
recursive-include tests *.py *.json
recursive-include skills *.md

# Keep local configuration, runtime data, and download metadata out of releases.
prune .venv
prune .git
prune public-release
prune data/jobs
prune data/private
prune .claude
prune .codex
prune .agents
global-exclude *:Zone.Identifier __pycache__ *.py[cod] *.log *.pem *.key
exclude .env .env.local .env.production
